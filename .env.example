# Firebase Configuration
# Get these values from Firebase Console → Project settings → Your apps (Web)
# Copy this file to .env and fill in the actual values

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# OpenAI API Configuration
# Required for Whisper transcription and GPT-4 narrative generation
# Get your API key from https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key-here

# Stable Diffusion API Configuration
# Required for artwork generation using Stable Diffusion
# Get your API URL and key from your Stable Diffusion provider (e.g., Replicate, Stability AI, or self-hosted)
EXPO_PUBLIC_STABLE_DIFFUSION_API_URL=https://your-stable-diffusion-api-url
EXPO_PUBLIC_STABLE_DIFFUSION_API_KEY=your-stable-diffusion-api-key
# Optional: Model name (defaults to stable-diffusion-v1-5)
EXPO_PUBLIC_STABLE_DIFFUSION_MODEL=stable-diffusion-v1-5

# Optional: Presidio API for PII detection (not required, will skip if not set)
# EXPO_PUBLIC_PRESIDIO_API_URL=
# EXPO_PUBLIC_PRESIDIO_API_KEY=
