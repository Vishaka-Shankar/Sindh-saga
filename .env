# OpenAI API Configuration
# REQUIRED FOR: Whisper transcription (Sindhi audio → text) + GPT-4o narrative generation (transcript → polished story)
# Get your API key from https://platform.openai.com/api-keys
# IMPORTANT: Without this key, transcription and story generation will NOT work
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key-here

# Stable Diffusion API Configuration
# REQUIRED FOR: Artwork generation (story text → Sindhi cultural illustration)
# Get your API URL and key from your Stable Diffusion provider:
#   - Replicate: https://replicate.com
#   - Stability AI: https://platform.stability.ai
#   - Self-hosted: Your own Stable Diffusion instance
# IMPORTANT: Without these credentials, artwork generation will NOT work
EXPO_PUBLIC_STABLE_DIFFUSION_API_URL=https://your-stable-diffusion-api-url
EXPO_PUBLIC_STABLE_DIFFUSION_API_KEY=your-stable-diffusion-api-key
# Optional: Model name (defaults to stable-diffusion-v1-5)
EXPO_PUBLIC_STABLE_DIFFUSION_MODEL=stable-diffusion-v1-5

# Optional: Presidio API for PII detection (not required, will skip if not set)
# EXPO_PUBLIC_PRESIDIO_API_URL=
# EXPO_PUBLIC_PRESIDIO_API_KEY=
